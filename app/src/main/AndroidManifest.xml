<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Haptic feedback from the floating button. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Cloud speech/cleanup when a key is set, and the one-time on-device model download. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to tell mobile data from Wi-Fi, so audio can be compressed harder on a slow connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the mic alive while recording even if the text field closes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Tokalot Keyboard offers a screenshot you just took on its bar, ready to paste (Settings › Keyboard). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Recording from a Bluetooth headset's mic (Settings › Recording › Microphone): opening the headset's call
         link. Neither asks anything; BLUETOOTH is only needed for that on Android 11 and older. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- In-app updates: lets Tokalot hand a newer signed APK to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Optional, never granted by installing: only if you run the adb command in Settings › Setup. Then, when an
         update leaves the mic button's accessibility service off, Tokalot switches it off and on again itself. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets Tokalot show app names (e.g. "Gmail") in history and the Style tab, and find the launchers
         that start out on Settings' clipboard-only list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Terminal commands: whether the termux-api commands can be offered in Termux. -->
        <package android:name="com.termux.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Tokalot" in the share sheet: voice notes (WhatsApp's, say) and text become notes. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <!-- After Tokalot updates itself: checks the mic button's service came back (see ServiceGuard). -->
        <receiver
            android:name=".ServiceGuard$UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".OfflineFlowService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Quick Settings tiles: dictate with no text box (types into one if there is, else copies),
             and Voice note (beta), which stays switched off until the beta is turned on in Settings. -->
        <service
            android:name=".DictateTile"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_dictate"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".NoteTile"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_note"
            android:label="@string/tile_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Tokalot Keyboard: a full keyboard with the mic and AI fix on its suggestion bar (see TokalotKeyboard). -->
        <service
            android:name=".TokalotKeyboard"
            android:exported="true"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Optional: spots a sign-in code in a new text so the keyboard can offer it (see CodeListener). -->
        <service
            android:name=".CodeListener"
            android:exported="true"
            android:label="@string/code_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Pictures the keyboard pastes, readable only by the app each one is given to (see KeyboardImages). -->
        <provider
            android:name=".KeyboardImageProvider"
            android:authorities="${applicationId}.kbimages"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
